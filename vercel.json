{
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 9 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/aplicacao", "destination": "/index.html" },
    { "source": "/aplicacao/(.*)", "destination": "/index.html" },
    { "source": "/mentoria", "destination": "/index.html" },
    { "source": "/mentoria/(.*)", "destination": "/index.html" },
    { "source": "/acervo-de-anuncios", "destination": "/acervo.html" },
    { "source": "/acervo-de-an(.*)", "destination": "/acervo.html" },
    { "source": "/acervo", "destination": "/acervo.html" },
    { "source": "/(.*)", "destination": "/membros.html" }
  ]
}
